{
  "stationCode": "PACKING-01",
  "databaseFileName": "packaging-station.db",
  "adb": {
    "path": "adb",
    "deviceSerial": "",
    "commandTimeoutSeconds": 10,
    "peripheralTimeoutSeconds": 45,
    "requireCompleteVersionSet": false
  },
  // 版本配置校验：全部版本号读完之后才执行，不参与采集过程。三段形状完全一样，各管各的组件。
  // enabled   组件总开关，默认开启；盒子、眼镜、手环三段都要校验，临时停用时才置 false。
  // enabled   也可以写在 checks 的每一项上，单独停用某条规则。
  // blockOnFail=false 时只提示不阻断；allowMissing=true 时该字段读不到就放行，false（默认）则读不到即判失败。
  // version    要求的版本号，**必须完全一致**：更高或更低都判失败。只写 x.y.z，读到的版本会忽略前导 v
  //            与 "-" 之后的构建信息再比较（如 v0.1.6-260920.053745-289545544 按 0.1.6），
  //            所以同一版本出新构建号不用改配置。旧名字 minVersion 仍可识别，语义已改成必须一致。
  // expected   字面精确值比对（trim 后完全相等），用于开关位这类非版本字段，填了它就不看 version。
  // 下面三段的值取自 2026-10-07 17:09 那次完整采集（换设备后的当前设备 D1S0100V38W263900191），
  // 就是这批设备实际在跑的版本：
  // 盒子 uboot 0.1.1 / kernel 0.1.7 / rootfs 0.1.7 / gen1App 0.5.2 / wlan0BtSwitch 0，
  // 眼镜 uboot 0.0.2 / kernel 0.0.8 / rootfs 0.0.6 / app 0.1.1，手环左右 3.0.3.6。
  // 换设备或换固件后必须同步改这里，否则会因为"与要求的版本不一致"被拦下（这正是锁版本的目的）。
  // 盒子字段：uboot、kernel、rootfs、gen1App、wlan0BtSwitch
  "boxVersion": {
    "enabled": true,
    "checks": [
      { "field": "uboot", "version": "0.1.1", "enabled": true, "blockOnFail": true },
      { "field": "kernel", "version": "0.1.7", "enabled": true, "blockOnFail": true },
      { "field": "rootfs", "version": "0.1.7", "enabled": true, "blockOnFail": true },
      { "field": "gen1App", "version": "0.5.2", "enabled": true, "blockOnFail": true },
      // 盒子 /oem/config/wlan0_bt_switch 的内容必须精确等于 expected（默认 0）。
      // 用 expected 而不是 version：这是开关位，不是版本号。
      { "field": "wlan0BtSwitch", "expected": "0", "enabled": true, "blockOnFail": true, "allowMissing": false }
    ]
  },
  // 眼镜字段：uboot、kernel、rootfs、app
  "glassesVersion": {
    "enabled": true,
    "checks": [
      { "field": "uboot", "version": "0.0.2", "enabled": true, "blockOnFail": true },
      { "field": "kernel", "version": "0.0.8", "enabled": true, "blockOnFail": true },
      { "field": "rootfs", "version": "0.0.6", "enabled": true, "blockOnFail": true },
      { "field": "app", "version": "0.1.1", "enabled": true, "blockOnFail": true }
    ]
  },
  // 手环字段：leftVersion、rightVersion（手环版本必须读到，allowMissing 保持 false）
  "bandVersion": {
    "enabled": true,
    "checks": [
      { "field": "leftVersion", "version": "3.0.3.6", "enabled": true, "blockOnFail": true, "allowMissing": false },
      { "field": "rightVersion", "version": "3.0.3.6", "enabled": true, "blockOnFail": true, "allowMissing": false }
    ]
  },
  "sn": {
    "productCode": "G1",
    "productName": "Origin Kit Gen1",
    "factoryCodes": [ "F" ],
    "defaultFactoryCode": "F",
    "initialSequence": 1
  },
  "factorySystem": {
    "mode": "swiftmom",
    "baseUrl": "http://192.168.10.17:8080/swiftmom/api",
    "clientLoginPath": "clientLogin",
    "checkRoutePath": "checkRoute",
    "createRoutePath": "createRoute",
    "userNo": "mss",
    "password": "mss524461",
    "prodNo": "WD2026090801A-01",
    "stationNo": "Z01",
    "retest": "0",
    "timeoutSeconds": 15
  },
  "printer": {
    "mode": "mock",
    "printerName": "",
    "templatePath": "D:\\BarTenderTemplates\\OriginKitGen1.btw",
    "snDataSourceName": "PackageSn",
    "barTenderSdkAssemblyPath": "",
    "copies": 1,
    "printTimeoutSeconds": 30,
    "labelWidthMm": 60,
    "labelHeightMm": 35
  },
  "workflow": {
    "requireUploadBeforeNext": true,
    "requirePrintBeforeNext": false
  }
}
