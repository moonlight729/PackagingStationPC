{
  "stationCode": "PACKING-01",
  "databaseFileName": "packaging-station.db",
  "adb": {
    "path": "adb",
    "deviceSerial": "",
    "commandTimeoutSeconds": 10,
    "peripheralTimeoutSeconds": 45,
    "requireCompleteVersionSet": false
  },
  // 版本配置校验：全部版本号读完之后才执行，不参与采集过程。三段形状完全一样，各管各的组件。
  // enabled   组件总开关，默认关闭；关掉的组件完全不校验。
  // enabled   也可以写在 checks 的每一项上，单独停用某条规则。
  // blockOnFail=false 时只提示不阻断；allowMissing=true 时该字段读不到就放行（手环版本是尽力读取的，建议配 true）。
  // minVersion 只写 x.y.z：读到的版本会忽略前导 v 与 "-" 之后的构建信息再比较（如 v0.1.6-260920 按 0.1.6）。
  // 下面三段的值取自 2026-10-07 16:33 那次完整采集（盒子 gen1App 0.5.2 / uboot 0.1.1 / kernel 0.1.6 / rootfs 0.1.6，
  // 眼镜 uboot 0.0.2 / kernel 0.0.7 / rootfs 0.0.6 / app 0.1.0，手环左右 3.0.3.6），按需调整后再把 enabled 打开。
  // 盒子字段：uboot、kernel、rootfs、gen1App
  "boxVersion": {
    "enabled": false,
    "checks": [
      { "field": "uboot", "minVersion": "0.1.1", "enabled": true, "blockOnFail": true },
      { "field": "kernel", "minVersion": "0.1.6", "enabled": true, "blockOnFail": true },
      { "field": "rootfs", "minVersion": "0.1.6", "enabled": true, "blockOnFail": true },
      { "field": "gen1App", "minVersion": "0.5.2", "enabled": true, "blockOnFail": true }
    ]
  },
  // 眼镜字段：uboot、kernel、rootfs、app
  "glassesVersion": {
    "enabled": false,
    "checks": [
      { "field": "uboot", "minVersion": "0.0.2", "enabled": true, "blockOnFail": true },
      { "field": "kernel", "minVersion": "0.0.7", "enabled": true, "blockOnFail": true },
      { "field": "rootfs", "minVersion": "0.0.6", "enabled": true, "blockOnFail": true },
      { "field": "app", "minVersion": "0.1.0", "enabled": true, "blockOnFail": true }
    ]
  },
  // 手环字段：leftVersion、rightVersion（手环版本是尽力读取的，保留 allowMissing）
  "bandVersion": {
    "enabled": false,
    "checks": [
      { "field": "leftVersion", "minVersion": "3.0.3.6", "enabled": true, "blockOnFail": true, "allowMissing": true },
      { "field": "rightVersion", "minVersion": "3.0.3.6", "enabled": true, "blockOnFail": true, "allowMissing": true }
    ]
  },
  "sn": {
    "productCode": "G1",
    "productName": "Origin Kit Gen1",
    "factoryCodes": [ "F" ],
    "defaultFactoryCode": "F",
    "initialSequence": 1
  },
  "factorySystem": {
    "mode": "swiftmom",
    "baseUrl": "http://192.168.10.17:8080/swiftmom/api",
    "clientLoginPath": "clientLogin",
    "checkRoutePath": "checkRoute",
    "createRoutePath": "createRoute",
    "userNo": "mss",
    "password": "mss524461",
    "prodNo": "WD2026090801A-01",
    "stationNo": "Z01",
    "retest": "0",
    "timeoutSeconds": 15
  },
  "printer": {
    "mode": "mock",
    "printerName": "",
    "templatePath": "D:\\BarTenderTemplates\\OriginKitGen1.btw",
    "snDataSourceName": "PackageSn",
    "barTenderSdkAssemblyPath": "",
    "copies": 1,
    "printTimeoutSeconds": 30,
    "labelWidthMm": 60,
    "labelHeightMm": 35
  },
  "workflow": {
    "requireUploadBeforeNext": true,
    "requirePrintBeforeNext": false
  }
}
