<Window x:Class="PackagingStationPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PackagingStationPC.Controls"
        Title="OriginFlow 包装工位"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172023" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProductName}" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="包装与数据绑定工位" Foreground="#B9C4C6" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StationCode}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding CurrentDeviceSerial, StringFormat=设备: {0}}" Foreground="#B9C4C6" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="18">
            <TabItem Header="生产操作">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ADB 设备" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="DisplayName" />
                            <Button Grid.Column="2" Content="刷新设备" Command="{Binding RefreshDevicesCommand}" Margin="10,0,8,0" />
                            <Button Grid.Column="3" Content="读取全部版本" Command="{Binding QueryVersionsCommand}" Style="{StaticResource PrimaryButton}" />
                            <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="570" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" MinWidth="390" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="产品 SN 与版本" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding VersionRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="组件" Binding="{Binding Component}" Width="110" />
                                        <DataGridTextColumn Header="字段" Binding="{Binding Field}" Width="125" />
                                        <DataGridTextColumn Header="SN / 版本值" Binding="{Binding Value}" Width="*" MinWidth="230" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="70" />
                                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="扫描外包装盒码" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBox x:Name="ScannerInputTextBox"
                                             Height="44"
                                             Padding="12,0"
                                             VerticalContentAlignment="Center"
                                             FontSize="17"
                                             FontFamily="Consolas"
                                             Text="{Binding ScannerInput, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="ScannerInputTextBox_OnKeyDown"
                                             TextChanged="ScannerInputTextBox_OnTextChanged" />
                                    <Button Content="提交扫码" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />

                                    <Border Background="#F3F8F7" BorderBrush="#B7D7D3" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="当前外包装盒码" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding ScannedPackageCode, TargetNullValue=-}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding CurrentDeviceSerial, StringFormat=设备 SN: {0}}" FontFamily="Consolas" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,18,0,0">
                                        <Border Background="#F5F6F7" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="上传状态" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding CurrentUploadStatus}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="105" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="1. MES 登录" Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LoginStageStatus}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1" Text="2. 过站检查" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CheckRouteStageStatus}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                                    <TextBlock Grid.Row="2" Text="3. 过站写入" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CreateRouteStageStatus}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 盒子系统时间：跟在"上传状态"卡片下面，标签列宽和卡片里的三阶段一致，读不到时留空。 -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="当前时间"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DeviceTimeText}"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#FFF8E8" BorderBrush="#E8C98A" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ModuleMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{Binding ModuleMessageBrush}" FontWeight="SemiBold" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="生产记录">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="最近 200 条记录" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Button Content="刷新记录" Command="{Binding RefreshRecordsCommand}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentRecords}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="外包装盒码" Binding="{Binding PackageSn}" Width="190" />
                            <DataGridTextColumn Header="设备 SN" Binding="{Binding DeviceSerial}" Width="190" />
                            <DataGridTextColumn Header="工位" Binding="{Binding StationCode}" Width="105" />
                            <DataGridTextColumn Header="上传" Binding="{Binding UploadStatus}" Width="90" />
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="165" />
                            <DataGridTextColumn Header="上传信息" Binding="{Binding UploadMessage}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E6EAEB" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding AppVersionDisplay, StringFormat=版本: {0}}"
                           VerticalAlignment="Center"
                           Margin="18,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontFamily="Consolas">
                    <TextBlock.ToolTip>
                        <TextBlock Text="{Binding AppVersionDetail}" TextWrapping="Wrap" MaxWidth="420" />
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding UploadMode, StringFormat=上传: {0}}" VerticalAlignment="Center" Margin="18,0" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
