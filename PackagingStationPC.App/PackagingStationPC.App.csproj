<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PackagingStationPC</AssemblyName>
    <RootNamespace>PackagingStationPC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PackagingStationPC.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    编译期取 git tag + commit 作为程序版本（git describe 带 tags/always/dirty/long 参数，
    例如 V1.0.0 之上一共 1 个提交时输出 V1.0.0 1 g393da69 dirty），
    写入 BuildVersionInfo.Describe 供界面状态栏显示。
    git 不可用或仓库无提交时回退为 unknown，由 BuildVersion 显示为"未知版本"。
  -->
  <Target Name="GenerateBuildVersionFile" BeforeTargets="CoreCompile">
    <Exec Command="git describe --tags --always --dirty --long"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribeOutput" />
    </Exec>
    <PropertyGroup>
      <GitDescribe>$(GitDescribeOutput.Trim())</GitDescribe>
      <GitDescribe Condition="'$(GitDescribe)' == ''">unknown</GitDescribe>
    </PropertyGroup>
    <ItemGroup>
      <BuildVersionSourceLine Include="// Generated by MSBuild target GenerateBuildVersionFile (git describe)." />
      <BuildVersionSourceLine Include="namespace PackagingStationPC%3B" />
      <BuildVersionSourceLine Include="internal static class BuildVersionInfo" />
      <BuildVersionSourceLine Include="%7B" />
      <BuildVersionSourceLine Include="%20%20%20%20public const string Describe = &quot;$(GitDescribe)&quot;%3B" />
      <BuildVersionSourceLine Include="%7D" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildVersion.g.cs"
                      Lines="@(BuildVersionSourceLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildVersion.g.cs" />
    </ItemGroup>
  </Target>
</Project>
